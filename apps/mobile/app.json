{
  "expo": {
    "name": "Explain It Back",
    "slug": "explain-it-back",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "explainitback",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.explainitback.app",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F5EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.explainitback.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "development",
          "iPhoneDeploymentTarget": "17.0"
        }
      ],
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Explain It Back records your voice so it can analyze your explanation."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F5EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 144
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      [
        "expo-status-bar",
        {
          "hidden": false,
          "style": "dark"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
