# ==================================================
# Explain It Back — Backend Environment Variables
# ==================================================

# --------------------------------------------------
# 1. Server
# --------------------------------------------------

PORT=3000

# Optional. Do not set to development in production.
# NODE_ENV=development


# --------------------------------------------------
# 2. Clerk Authentication
# --------------------------------------------------

# From the same Clerk application
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=


# --------------------------------------------------
# 3. PostgreSQL / Supabase
# --------------------------------------------------

DATABASE_URL=


# --------------------------------------------------
# 4. OpenAI
# --------------------------------------------------

# Required for real AI analysis, question generation,
# and review-answer evaluation.
OPENAI_API_KEY=

# Optional: model for explanation analysis.
# Default: gpt-6-luna
EXPLANATION_ANALYSIS_MODEL=gpt-6-luna

# Optional: speech-to-text model.
# Default: gpt-4o-mini-transcribe
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe


# --------------------------------------------------
# 5. Speech-to-Text Dry Run
# --------------------------------------------------

# true:
#   Returns a fake transcript.
#
# false:
#   Sends actual audio to OpenAI.
#
# IMPORTANT:
# This flag only controls transcription.
# AI analysis and review question generation
# can still make real OpenAI API requests.

TRANSCRIPTION_DRY_RUN=true


# --------------------------------------------------
# 6. Review Answer Evaluation
# --------------------------------------------------

# false:
#   Uses the real OpenAI evaluation.
#
# true:
#   Uses a fake evaluator for development/E2E testing.
#
# NEVER enable the fake evaluator in production.

FAKE_AI_EVALUATION=false


# --------------------------------------------------
# 7. OneSignal Push Notifications
# --------------------------------------------------

# Must match the OneSignal App ID in the mobile app.
ONESIGNAL_APP_ID=4ef89c9c-db70-4019-9b48-5cbd71f70e87

# Secret server-side API key.
ONESIGNAL_REST_API_KEY=


# --------------------------------------------------
# 8. Notification Worker
# --------------------------------------------------

# true:
#   Finds eligible users but sends no notifications.
#
# false:
#   Allows real OneSignal notification requests.
#
# Keep true until real-device verification
# and production-send approval are complete.

NOTIFICATION_DRY_RUN=true


# --------------------------------------------------
# 9. Test Database (Optional)
# --------------------------------------------------

# Used only for database integration tests.
# Must be an isolated database, never production.
# TEST_DATABASE_URL=


# --------------------------------------------------
# 10. RevenueCat
# --------------------------------------------------

# Secret API key (starts with sk_), never shipped in the app.
# RevenueCat dashboard → Project settings → API keys → Secret API keys.
# Used to read GET /v1/subscribers/{app_user_id}.
REVENUECAT_SECRET_API_KEY=