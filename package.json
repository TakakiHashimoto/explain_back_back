{
  "name": "explain-it-back",
  "version": "0.0.0",
  "private": true,
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "backend": "bun run --filter @explain-it-back/backend dev",
    "android": "bun run --filter @explain-it-back/mobile start:android",
    "ios": "bun run --filter @explain-it-back/mobile start:ios",
    "start:mobile": "bun run --filter @explain-it-back/mobile start",
    "dev:android": "concurrently -n BACKEND,ANDROID \"bun run backend\" \"bun run android\"",
    "dev:ios": "concurrently -n BACKEND,IOS \"bun run backend\" \"bun run ios\"",
    "dev:all": "concurrently \"bun run backend\" \"bun run start:mobile\"",
    "typecheck:backend": "bun run --filter @explain-it-back/backend typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "@types/bun": "latest"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "module": "index.ts",
  "type": "module",
  "peerDependencies": {
    "typescript": "^7"
  }
}
